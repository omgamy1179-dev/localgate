# sdist contents (the wheel ships only the localgate package)
include LICENSE
include README.md
include CHANGELOG.md
include SECURITY.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SUPPORT.md
include config.yaml
recursive-include tests *.py
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
prune data
prune logs
prune dist
